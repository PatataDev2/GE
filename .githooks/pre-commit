#!/bin/sh
# Pre-commit hook to prevent accidental commits of the SQLite database

STAGED_DB=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "db\.sqlite3|db_backup\.sqlite3$" || true)

if [ -n "$STAGED_DB" ]; then
    echo ""
    echo "ERROR: You are trying to commit the SQLite database file!"
    echo "  $STAGED_DB"
    echo ""
    echo "This should NOT be committed. The .gitignore should exclude it."
    echo "If you need to share data, use: python manage.py backup_restore backup"
    echo ""
    exit 1
fi

# ESLint check on staged JS/JSX files
cd frontend || exit 1
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "\.(js|jsx)$" || true)
if [ -n "$STAGED_FILES" ]; then
    echo "$STAGED_FILES" | xargs npx eslint --fix
    if [ $? -ne 0 ]; then
        echo ""
        echo "ERROR: ESLint found errors in staged files. Fix them before committing."
        echo ""
        exit 1
    fi
fi
